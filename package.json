{
  "name": "kn-woodwinds-transcription-player",
  "version": "1.0.13",
  "description": "KN Woodwinds Transcription Player: slow down music without changing pitch, freeze a note, A-B loop, key and tempo detection",
  "main": "main.js",
  "author": "KN Woodwinds",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.transcriptionplayer",
    "productName": "KN Woodwinds Transcription Player",
    "files": [
      "main.js",
      "index.html",
      "icon.ico",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "KN-Woodwinds-Transcription-Player-Setup.${ext}"
    },
    "portable": {
      "artifactName": "KN-Woodwinds-Transcription-Player-Portable.${ext}"
    }
  }
}